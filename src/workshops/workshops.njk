---
layout: base
title: Workshops
description: Workshops and such.
slug: workshops
eleventyExcludeFromCollections: ["workshops"]
---
<div class="grid-wide grid-subgrid">
    <section class="grid-wide">
        <h1>Workshops</h1>
    </section>
    <div class="grid-item-3">
        <figure>
            <img src="/_assets/img/workshops/michael.jpeg" alt="slug" />            
        </figure>
    </div>
<section class="grid-item-4 grid-align-middle">
    <p class="big-p">I host and facilitate workshops to help people and teams get in touch with their most authentic and creative selves. With over ten years in consulting, I've seen it all.</p>
</section>
<div class="rule grid-item-5 grid-offset-1 grid-gutter-slug"></div>
<section class="grid-item-6 grid-offset-2 grid-subgrid">
    <div class="grid-wide">
        <h2>Upcoming Workshops</h2>
        <p>
            Nothing yet! Watch this space or <a href="">sign up for updates</a>.
        </p>
    </div>
</section>

<section class="grid-item-6 grid-offset-2 grid-subgrid grid-tight">
    <div class="grid-wide">
        <h2>Past Workshops</h2>
    </div>
    {% for post in collections.workshops %}
        <article class="story grid-item-3">
            <a href="{{ post.url }}" >
                {% if post.data.thumbnail %}
                    <img src="{{ post.data.thumbnail }}" alt="{{ post.data.description }}" class="post-thumbnail"/>
                {% else %}
                    <img src="/_assets/img/story-thumbnail.png" alt="{{ post.data.description }}" class="post-thumbnail"/>
                {% endif %}
            </a>
                <h2>
                    {% if post.data.original.url %}
                        <a href="{{ post.data.original.url }}" target="_blank">{{ post.data.title }}<ion-icon name='open-outline'></ion-icon></a>
                    {% else %}
                        <a href="{{ post.url }}">{{ post.data.title }}</a>
                    {% endif %}
                </h2>
                {% if post.data.original.title %}
                    <p class="original">
                        {{ post.data.original.title }}, <time datetime="{{ post.date | shortDate }}">{{ post.data.original.date | postDate }}</time>
                    </p>
                {% endif %}
                {% if post.data.description %}
                    <p>
                        {{ post.data.description }}
                    </p>
                {% endif %}
        </article>
    {% endfor %}
</section>
</div>
